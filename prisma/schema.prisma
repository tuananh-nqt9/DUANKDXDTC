// Prisma schema cho website Thanh Chương JSC
// Database: SQLite (free, chạy local được)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User - Quản trị viên
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Bcrypt hash
  name      String
  role      String   @default("admin") // admin | editor
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Service - Dịch vụ / Ngành nghề
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  icon        String   @default("wrench") // Lucide icon name
  excerpt     String?
  content     String?
  image       String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Project - Dự án
model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  client      String?
  location    String?
  year        Int?
  category    String?
  excerpt     String?
  content     String?
  image       String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Post - Tin tức
model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  image       String?
  author      String?  @default("Admin")
  category    String?
  views       Int      @default(0)
  published   Boolean  @default(true)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Contact - Liên hệ từ khách hàng
model Contact {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  service   String?
  message   String
  status    String   @default("new") // new | read | replied
  createdAt DateTime @default(now())
}

// TestCategory - Danh mục chỉ tiêu phép thử
model TestCategory {
  id          String   @id @default(cuid())
  title       String   // Tên danh mục: "Thí nghiệm đất", "Thí nghiệm bê tông", ...
  slug        String   @unique
  description String?
  icon        String   @default("flask-conical") // Lucide icon name
  pdfUrl      String?  // Link file PDF chỉ tiêu phép thử
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tests       Test[]
}

// Test - Chỉ tiêu phép thử
model Test {
  id          String       @id @default(cuid())
  categoryId  String
  category    TestCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String       // Tên phép thử
  standard    String?      // Tiêu chuẩn: TCVN, ASTM, ...
  description String?
  order       Int          @default(0)
  published   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Equipment - Trang thiết bị
model Equipment {
  id           String   @id @default(cuid())
  name         String   // Tên thiết bị
  slug         String   @unique
  model        String?  // Model/số hiệu
  manufacturer String?  // Nhà sản xuất
  origin       String?  // Xuất xứ
  year         Int?     // Năm sản xuất
  description  String?
  specs        String?  // Thông số kỹ thuật (JSON hoặc text)
  image        String?
  category     String?  // "Thí nghiệm đất", "Thí nghiệm bê tông", ...
  order        Int      @default(0)
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
